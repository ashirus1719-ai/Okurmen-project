# Neon -> Connect -> connection string (pooled, with -pooler in the hostname).
# Keep the SSL parameters provided by Neon. Never use NEXT_PUBLIC_ for this URL.
DATABASE_URL=""

# Optional direct connection to the SAME database/branch for Prisma migrations.
# When empty, Prisma CLI uses DATABASE_URL.
DIRECT_URL=""

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth client. Add http://localhost:3000/api/auth/callback/google
# and your production callback URL to the OAuth client's authorized redirects.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend API key and a verified sender, e.g. Okurmen IT <auth@example.com>.
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""
